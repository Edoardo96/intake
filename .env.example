# Copy to .env on the server and fill in the values. Never commit .env.

# Public URL of the app, used for OAuth redirect URLs (no trailing slash).
# Use http://localhost:3000 for local development.
PUBLIC_BASE_URL=

# HTTP port inside the container
PORT=3000

# Directory for the SQLite database and encrypted tokens (use ./data for local development)
DATA_DIR=/data

# Google sign-in (OAuth client of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed to sign in
OWNER_EMAIL=

# Random secret used to sign session cookies (at least 32 characters)
SESSION_SECRET=

# Random key used to encrypt the Nutrition MCP refresh token (at least 32 characters)
TOKEN_ENCRYPTION_KEY=

# Nutrition MCP server endpoint
NUTRITION_MCP_URL=https://nutrition-mcp.com/mcp

# Optional: Hevy API key (Hevy Pro → Settings → Developer) to show workouts on Timeline and Trends
HEVY_API_KEY=

# Optional: openGym (self-hosted gym tracker) as the workout source instead of Hevy.
# Token from openGym Settings → API tokens, "view" on workouts and plans is enough.
OPENGYM_URL=
OPENGYM_TOKEN=
# Optional: public openGym address for "Apri in openGym" links when OPENGYM_URL is an internal one
OPENGYM_PUBLIC_URL=

# Optional: Claude API key (console.anthropic.com → API keys) to log meals from a photo or a description.
# Without it the photo and text options are hidden. Billed per use by Anthropic.
ANTHROPIC_API_KEY=
# Optional: Claude model for the recognition (default claude-sonnet-5-5; claude-haiku-5-5 is cheaper)
RECOGNITION_MODEL=
